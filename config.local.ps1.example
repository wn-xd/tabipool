# Per-person config for the tabipool proxy. Copy to config.local.ps1 (gitignored)
# and set your own values. Both installers read this and refuse to install if it
# is missing, rather than start an open proxy with a default token.
$PROXY_TOKEN = "change-me-to-a-long-random-string"
$PORT        = 8787
$UI_PORT     = 80          # friendly http://tabi.localhost/ ; set 0 to disable
$HOST_ADDR   = "127.0.0.1"
